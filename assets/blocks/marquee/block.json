{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/marquee",
  "version": "1.0.0",
  "title": "Marquee / Running Ticker",
  "category": "gravisain-blocks",
  "icon": "slides",
  "description": "Continuous running text, partner logos, or sponsor badges with smooth infinite marquee animation.",
  "keywords": [
    "marquee",
    "ticker",
    "running text",
    "logo ticker",
    "infinite scroll",
    "partners"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "anchor": false,
    "customClassName": false,
    "customCSS": false,
    "__experimentalCustomCSS": false
  },
  "attributes": {
    "speed": {
      "type": "number",
      "default": 25
    },
    "direction": {
      "type": "string",
      "default": "left"
    },
    "gap": {
      "type": "number",
      "default": 48
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "fadeMask": {
      "type": "boolean",
      "default": false
    },
    "minHeight": {
      "type": "number",
      "default": 60
    },
    "imageHeight": {
      "type": "number",
      "default": 0
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "borderRadius": {
      "type": "number",
      "default": 0
    },
    "padding": {
      "type": "object",
      "default": {}
    },
    "margin": {
      "type": "object",
      "default": {}
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "customClassName": {
      "type": "string",
      "default": ""
    },
    "customCSS": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "gravisain",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}