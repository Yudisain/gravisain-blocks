{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/faq-item",
  "version": "1.0.0",
  "title": "FAQ Item",
  "category": "gravisain-blocks",
  "icon": "arrow-down-alt2",
  "description": "An individual FAQ item with customizable question, answer, icons, and state styling.",
  "textdomain": "gravisain-blocks",
  "parent": [
    "gravisain/faq-accordion"
  ],
  "usesContext": [
    "gravisain/faqIconType",
    "gravisain/faqIconSize",
    "gravisain/faqIconColorNormal",
    "gravisain/faqIconColorActive"
  ],
  "attributes": {
    "question": {
      "type": "string",
      "default": "Question here..."
    },
    "isOpen": {
      "type": "boolean",
      "default": false
    },
    "iconType": {
      "type": "string",
      "default": "inherit"
    },
    "parentIcon": {
      "type": "string",
      "default": "arrow-down-alt2"
    },
    "headerPaddingTop": {
      "type": "number",
      "default": 24
    },
    "headerPaddingBottom": {
      "type": "number",
      "default": 24
    },
    "headerPaddingLeft": {
      "type": "number",
      "default": 24
    },
    "headerPaddingRight": {
      "type": "number",
      "default": 24
    },
    "contentPaddingTop": {
      "type": "number",
      "default": 0
    },
    "contentPaddingBottom": {
      "type": "number",
      "default": 24
    },
    "contentPaddingLeft": {
      "type": "number",
      "default": 24
    },
    "contentPaddingRight": {
      "type": "number",
      "default": 24
    },
    "questionFontSize": {
      "type": "number",
      "default": 18
    },
    "questionColorNormal": {
      "type": "string",
      "default": "#1e293b"
    },
    "questionColorActive": {
      "type": "string",
      "default": "#4f46e5"
    },
    "headerBgNormal": {
      "type": "string",
      "default": "#ffffff"
    },
    "headerBgActive": {
      "type": "string",
      "default": "#f8fafc"
    },
    "iconColorNormal": {
      "type": "string"
    },
    "iconColorActive": {
      "type": "string"
    },
    "iconSize": {
      "type": "number"
    },
    "contentBg": {
      "type": "string",
      "default": "#ffffff"
    },
    "borderColorNormal": {
      "type": "string",
      "default": "#e2e8f0"
    },
    "borderColorActive": {
      "type": "string",
      "default": "#4f46e5"
    },
    "borderWidth": {
      "type": "number",
      "default": 1
    },
    "borderRadius": {
      "type": "number",
      "default": 8
    },
    "boxShadow": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}