{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/icon-list",
  "version": "1.0.0",
  "title": "Icon List",
  "category": "gravisain-blocks",
  "icon": "list-view",
  "description": "Create engaging bulleted lists with custom icons, colors, and responsive layouts.",
  "textdomain": "gravisain",
  "supports": {
    "html": false,
    "anchor": false,
    "customClassName": false,
    "customCSS": false,
    "__experimentalCustomCSS": false
  },
  "attributes": {
    "items": {
      "type": "array",
      "default": [
        {
          "id": 1,
          "text": "High performance clean architecture",
          "icon": "check",
          "color": "#10b981"
        },
        {
          "id": 2,
          "text": "Fully responsive and mobile optimized",
          "icon": "check",
          "color": "#10b981"
        },
        {
          "id": 3,
          "text": "Seamless Gutenberg block integration",
          "icon": "check",
          "color": "#10b981"
        }
      ]
    },
    "layout": {
      "type": "string",
      "default": "vertical"
    },
    "itemGap": {
      "type": "number",
      "default": 12
    },
    "iconSize": {
      "type": "number",
      "default": 20
    },
    "iconColor": {
      "type": "string",
      "default": "#10b981"
    },
    "textColor": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "number",
      "default": 16
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "customClassName": {
      "type": "string",
      "default": ""
    },
    "customCSS": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}