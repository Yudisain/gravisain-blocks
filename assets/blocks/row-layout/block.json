    "borderStyle": {
      "type": "string",
      "default": "none"
    },
    "borderStyleTablet": {
      "type": "string",
      "default": "none"
    },
    "borderStyleMobile": {
      "type": "string",
      "default": "none"
    },
    "borderWidth": {
      "type": "number",
      "default": 0
    },
    "borderWidthTablet": {
      "type": "number",
      "default": 0
    },
    "borderWidthMobile": {
      "type": "number",
      "default": 0
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "borderColorTablet": {
      "type": "string",
      "default": ""
    },
    "borderColorMobile": {
      "type": "string",
      "default": ""
    },
    "boxShadow": {
      "type": "string",
      "default": "none"
    },
    "boxShadowTablet": {
      "type": "string",
      "default": "none"
    },
    "boxShadowMobile": {
      "type": "string",
      "default": "none"
