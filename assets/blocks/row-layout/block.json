{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/row-layout",
  "version": "1.1.0",
  "title": "Row Layout",
  "category": "gravisain-blocks",
  "icon": "grid-view",
  "description": "A flexible multi-column grid container.",
  "textdomain": "gravisain",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": false,
    "customClassName": false,
    "customCSS": false,
    "__experimentalCustomCSS": false
  },
  "attributes": {
    "anchor": {
      "type": "string",
      "default": ""
    },
    "customClassName": {
      "type": "string",
      "default": ""
    },
    "customCSS": {
      "type": "string",
      "default": ""
    },
    "align": {
      "type": "string",
      "default": ""
