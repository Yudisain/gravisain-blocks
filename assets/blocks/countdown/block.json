{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gravisain/countdown",
	"version": "1.0.0",
	"title": "Countdown Timer",
	"category": "gravisain-blocks",
	"icon": "clock",
	"description": "Create urgency with an interactive countdown timer showing days, hours, minutes, and seconds.",
	"textdomain": "gravisain-blocks",
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"__experimentalCustomCSS": false,
		"__experimentalBorder": false,
		"border": false,
		"color": false,
		"spacing": false
	},
	"attributes": {
		"targetDate": { "type": "string", "default": "2026-12-31T23:59:59" },
		"timezoneBasis": { "type": "string", "default": "site" },
		"siteOffset": { "type": "string", "default": "+00:00" },
		"labelDays": { "type": "string", "default": "Days" },
		"labelHours": { "type": "string", "default": "Hours" },
		"labelMinutes": { "type": "string", "default": "Minutes" },
		"labelSeconds": { "type": "string", "default": "Seconds" },
		"showDays": { "type": "boolean", "default": true },
		"showHours": { "type": "boolean", "default": true },
		"showMinutes": { "type": "boolean", "default": true },
		"showSeconds": { "type": "boolean", "default": true },
		"layout": { "type": "string", "default": "boxes" },
		"boxBackgroundColor": { "type": "string", "default": "#f8fafc" },
		"numberColor": { "type": "string", "default": "#007cba" },
		"labelColor": { "type": "string", "default": "#666666" },
		"borderColor": { "type": "string", "default": "#e2e8f0" },
		"borderWidth": { "type": "number", "default": 1 },
		"borderRadius": { "type": "number", "default": 8 },
		"numberFontSize": { "type": "number", "default": 36 },
		"labelFontSize": { "type": "number", "default": 14 },
		"gap": { "type": "number", "default": 16 },
		"expiryAction": { "type": "string", "default": "message" },
		"expiryMessage": { "type": "string", "default": "This event has ended!" },
		"alignment": { "type": "string", "default": "center" },
		"alignmentTablet": { "type": "string", "default": "" },
		"alignmentMobile": { "type": "string", "default": "" },
		"anchor": { "type": "string", "default": "" },
		"customClassName": { "type": "string", "default": "" },
		"customCSS": { "type": "string", "default": "" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
