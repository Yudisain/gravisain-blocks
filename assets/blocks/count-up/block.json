{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/count-up",
  "version": "1.0.0",
  "title": "Count Up / Number Counter",
  "category": "gravisain-blocks",
  "icon": "performance",
  "description": "An animated number counter for statistics, achievements, and metrics when scrolled into view.",
  "textdomain": "gravisain-blocks",
  "supports": {
    "html": false,
    "anchor": false,
    "customClassName": false,
    "customCSS": false,
    "__experimentalCustomCSS": false
  },
  "attributes": {
    "startNumber": {
      "type": "number",
      "default": 0
    },
    "endNumber": {
      "type": "number",
      "default": 1000
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": "+"
    },
    "title": {
      "type": "string",
      "default": "Happy Customers"
    },
    "duration": {
      "type": "number",
      "default": 2.5
    },
    "decimalPlaces": {
      "type": "number",
      "default": 0
    },
    "numberFontSize": {
      "type": "number",
      "default": 42
    },
    "titleFontSize": {
      "type": "number",
      "default": 18
    },
    "numberColor": {
      "type": "string",
      "default": "#007cba"
    },
    "titleColor": {
      "type": "string",
      "default": "#666666"
    },
    "alignment": {
      "type": "string",
      "default": "center"
    },
    "alignmentTablet": {
      "type": "string",
      "default": ""
    },
    "alignmentMobile": {
      "type": "string",
      "default": ""
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "customClassName": {
      "type": "string",
      "default": ""
    },
    "customCSS": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}