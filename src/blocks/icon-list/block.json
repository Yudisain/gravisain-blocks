{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gravisain/icon-list",
	"version": "1.1.0",
	"title": "Icon List",
	"category": "gravisain-blocks",
	"icon": "list-view",
	"description": "Create engaging bulleted lists with custom icons, colors, and responsive layouts.",
	"textdomain": "gravisain",
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"__experimentalCustomCSS": false
	},
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{ "id": 1, "text": "High performance clean architecture", "icon": "check", "color": "", "background": "" },
				{ "id": 2, "text": "Fully responsive and mobile optimized", "icon": "check", "color": "", "background": "" },
				{ "id": 3, "text": "Seamless Gutenberg block integration", "icon": "check", "color": "", "background": "" }
			]
		},
		"layout": { "type": "string", "default": "vertical" },
		"alignment": { "type": "string", "default": "left" },
		"alignmentTablet": { "type": "string", "default": "" },
		"alignmentMobile": { "type": "string", "default": "" },
		"itemGap": { "type": "number", "default": 12 },
		"defaultIcon": { "type": "string", "default": "check" },
		"iconSize": { "type": "number", "default": 20 },
		"iconColor": { "type": "string", "default": "#10b981" },
		"iconBackground": { "type": "string", "default": "" },
		"iconPadding": { "type": "number", "default": 0 },
		"iconRadius": { "type": "number", "default": 0 },
		"textColor": { "type": "string", "default": "" },
		"fontFamily": { "type": "string", "default": "" },
		"fontWeight": { "type": "string", "default": "" },
		"fontStyle": { "type": "string", "default": "normal" },
		"fontSize": { "type": "number", "default": 16 },
		"fontSizeTablet": { "type": "number" },
		"fontSizeMobile": { "type": "number" },
		"lineHeight": { "type": "string", "default": "" },
		"lineHeightTablet": { "type": "string" },
		"lineHeightMobile": { "type": "string" },
		"letterSpacing": { "type": "string", "default": "" },
		"letterSpacingTablet": { "type": "string" },
		"letterSpacingMobile": { "type": "string" },
		"padding": { "type": "object", "default": {} },
		"paddingTablet": { "type": "object", "default": {} },
		"paddingMobile": { "type": "object", "default": {} },
		"margin": { "type": "object", "default": {} },
		"marginTablet": { "type": "object", "default": {} },
		"marginMobile": { "type": "object", "default": {} },
		"anchor": { "type": "string", "default": "" },
		"customClassName": { "type": "string", "default": "" },
		"customCSS": { "type": "string", "default": "" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
