{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gravisain/spacer",
	"version": "1.0.0",
	"title": "Spacer / Divider",
	"category": "gravisain-blocks",
	"icon": "arrows-up-down",
	"description": "Add responsive height spacing with an optional decorative divider between sections or blocks.",
	"textdomain": "gravisain",
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"__experimentalCustomCSS": false
	},
	"attributes": {
		"height": {
			"type": "number",
			"default": 60
		},
		"heightTablet": {
			"type": "number",
			"default": 40
		},
		"heightMobile": {
			"type": "number",
			"default": 30
		},
		"showDivider": {
			"type": "boolean",
			"default": false
		},
		"dividerStyle": {
			"type": "string",
			"default": "solid"
		},
		"dividerColor": {
			"type": "string",
			"default": "#e0e0e0"
		},
		"dividerWidth": {
			"type": "number",
			"default": 80
		},
		"dividerHeight": {
			"type": "number",
			"default": 1
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"customClassName": {
			"type": "string",
			"default": ""
		},
		"customCSS": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
