{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gravisain/table",
	"version": "1.0.0",
	"title": "Advanced / Pricing Table",
	"category": "gravisain-blocks",
	"icon": "editor-table",
	"description": "Build responsive comparison tables and pricing plans with highlighted columns, headers, and striped rows.",
	"textdomain": "gravisain",
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"__experimentalCustomCSS": false
	},
	"attributes": {
		"rows": { "type": "number", "default": 4 },
		"columns": { "type": "number", "default": 3 },
		"data": {
			"type": "array",
			"default": [
				[ "Feature / Plan", "Standard", "Pro (Popular)" ],
				[ "Storage Space", "10 GB", "100 GB" ],
				[ "Support", "Email Only", "24/7 Priority" ],
				[ "Price", "$9 / mo", "$29 / mo" ]
			]
		},
		"hasHeader": { "type": "boolean", "default": true },
		"stripedRows": { "type": "boolean", "default": true },
		"hoverEffect": { "type": "boolean", "default": true },
		"highlightColumn": { "type": "number", "default": 2 },
		"headerBackgroundColor": { "type": "string", "default": "#007cba" },
		"headerTextColor": { "type": "string", "default": "#ffffff" },
		"highlightBackgroundColor": { "type": "string", "default": "#f0f9ff" },
		"borderColor": { "type": "string", "default": "#e2e8f0" },
		"cellPadding": { "type": "number", "default": 14 },
		"fontSize": { "type": "number", "default": 15 },
		"anchor": { "type": "string", "default": "" },
		"customClassName": { "type": "string", "default": "" },
		"customCSS": { "type": "string", "default": "" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
