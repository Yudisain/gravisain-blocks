{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gravisain/image",
	"version": "1.0.0",
	"title": "Advanced Image",
	"category": "gravisain-blocks",
	"icon": "format-image",
	"description": "Insert an advanced image with aspect ratios, overlays, borders, shadows, and captions.",
	"textdomain": "gravisain",
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"__experimentalCustomCSS": false
	},
	"attributes": {
		"id": { "type": "number", "default": 0 },
		"url": { "type": "string", "default": "" },
		"alt": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"caption": { "type": "string", "default": "" },
		"width": { "type": "number", "default": 0 },
		"height": { "type": "number", "default": 0 },
		"aspectRatio": { "type": "string", "default": "auto" },
		"objectFit": { "type": "string", "default": "cover" },
		"borderRadius": { "type": "number", "default": 0 },
		"borderWidth": { "type": "number", "default": 0 },
		"borderColor": { "type": "string", "default": "#cccccc" },
		"borderStyle": { "type": "string", "default": "solid" },
		"boxShadow": { "type": "string", "default": "none" },
		"overlayColor": { "type": "string", "default": "" },
		"overlayOpacity": { "type": "number", "default": 0 },
		"link": { "type": "string", "default": "" },
		"linkTarget": { "type": "string", "default": "_self" },
		"alignment": { "type": "string", "default": "center" },
		"alignmentTablet": { "type": "string", "default": "" },
		"alignmentMobile": { "type": "string", "default": "" },
		"anchor": { "type": "string", "default": "" },
		"customClassName": { "type": "string", "default": "" },
		"customCSS": { "type": "string", "default": "" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
