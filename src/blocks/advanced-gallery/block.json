{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gravisain/advanced-gallery",
	"version": "0.1.0",
	"title": "Advanced Gallery",
	"category": "gravisain-blocks",
	"icon": "images-alt2",
	"description": "Create stunning, responsive image galleries with advanced layout options.",
	"keywords": [ "gallery", "images", "masonry", "grid" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"images": {
			"type": "array",
			"default": []
		},
		"columns": {
			"type": "object",
			"default": { "desktop": 3, "tablet": 2, "mobile": 1 }
		},
		"gap": {
			"type": "object",
			"default": { "desktop": 20, "tablet": 15, "mobile": 10 }
		},
		"layout": {
			"type": "string",
			"default": "grid"
		},
		"imageRatio": {
			"type": "string",
			"default": "square"
		},
		"enableLightbox": {
			"type": "boolean",
			"default": true
		},
		"imageRadius": {
			"type": "number",
			"default": 0
		},
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "gravisain-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
