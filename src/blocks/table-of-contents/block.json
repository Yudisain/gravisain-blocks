{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gravisain/table-of-contents",
	"version": "1.0.0",
	"title": "Table of Contents",
	"category": "gravisain-blocks",
	"icon": "editor-ul",
	"description": "Automatically generate a table of contents from headings inside your page or article.",
	"textdomain": "gravisain",
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"__experimentalCustomCSS": false
	},
	"attributes": {
		"title": { "type": "string", "default": "Table of Contents" },
		"allowedHeaders": { "type": "array", "default": [ false, true, true, true, false, false ] },
		"listStyle": { "type": "string", "default": "ul" },
		"collapsible": { "type": "boolean", "default": true },
		"startCollapsed": { "type": "boolean", "default": false },
		"smoothScroll": { "type": "boolean", "default": true },
		"containerBackgroundColor": { "type": "string", "default": "#f8fafc" },
		"titleColor": { "type": "string", "default": "#1a202c" },
		"linkColor": { "type": "string", "default": "#007cba" },
		"linkHoverColor": { "type": "string", "default": "#005a87" },
		"borderColor": { "type": "string", "default": "#e2e8f0" },
		"borderRadius": { "type": "number", "default": 8 },
		"contentPadding": { "type": "number", "default": 20 },
		"anchor": { "type": "string", "default": "" },
		"customClassName": { "type": "string", "default": "" },
		"customCSS": { "type": "string", "default": "" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
