{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/show-more",
  "version": "0.1.0",
  "title": "Show More",
  "category": "gravisain-blocks",
  "icon": "arrow-down-alt2",
  "description": "Hide long content behind a 'Read More' button that expands when clicked.",
  "keywords": [
    "show more",
    "read more",
    "expand",
    "collapse",
    "accordion"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "previewHeight": {
      "type": "number",
      "default": 250
    },
    "showMoreText": {
      "type": "string",
      "default": "Read More"
    },
    "showLessText": {
      "type": "string",
      "default": "Read Less"
    },
    "enableShowLess": {
      "type": "boolean",
      "default": true
    },
    "buttonAlign": {
      "type": "string",
      "default": "center"
    },
    "fadeColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "anchor": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "gravisain-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}