{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/testimonials",
  "version": "0.1.0",
  "title": "Testimonials Grid",
  "category": "gravisain-blocks",
  "icon": "format-quote",
  "description": "A container to display multiple testimonials in a grid or carousel layout.",
  "keywords": [
    "testimonials",
    "reviews",
    "grid",
    "carousel"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "columns": {
      "type": "object",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      }
    },
    "gap": {
      "type": "object",
      "default": {
        "desktop": 20,
        "tablet": 15,
        "mobile": 10
      }
    },
    "layout": {
      "type": "string",
      "default": "grid"
    },
    "anchor": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "gravisain-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}