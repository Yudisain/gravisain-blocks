{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/buttons",
  "version": "1.0.0",
  "title": "Advanced Buttons",
  "category": "gravisain-blocks",
  "icon": "button",
  "description": "A wrapper for advanced buttons.",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "anchor": false,
    "customClassName": false,
    "customCSS": false,
    "__experimentalCustomCSS": false
  },
  "attributes": {
    "anchor": {
      "type": "string",
      "default": ""
    },
    "customClassName": {
      "type": "string",
      "default": ""
    },
    "customCSS": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "horizontal"
    },
    "justifyContent": {
      "type": "string",
      "default": "flex-start"
    },
    "gap": {
      "type": "number",
      "default": 16
    }
  },
  "textdomain": "gravisain",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}