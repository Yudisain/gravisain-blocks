{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gravisain/tab-pane",
  "version": "1.0.0",
  "title": "Tab Pane",
  "category": "gravisain-blocks",
  "parent": [
    "gravisain/tabs"
  ],
  "icon": "welcome-add-page",
  "description": "Content area for an individual tab.",
  "textdomain": "gravisain",
  "usesContext": [
    "gravisain/activeTab"
  ],
  "supports": {
    "html": false,
    "reusable": false,
    "inserter": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css"
}