{
  "name": "gravisain-blocks",
  "version": "1.0.0",
  "description": "Gravisain Blocks & Gutenberg Pattern Library Companion Plugin",
  "private": true,
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src/blocks --output-path=assets/blocks",
    "start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=assets/blocks",
    "blocks:zip": "powershell -ExecutionPolicy Bypass -File scripts/zip-plugin.ps1",
    "theme:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain/scripts/zip-theme.ps1",
    "starter-sites:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain-starter-sites/scripts/zip-starter-sites.ps1",
    "studio:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain-studio/scripts/zip-plugin.ps1",
    "all:zip": "npm run blocks:zip && npm run theme:zip && npm run starter-sites:zip && npm run studio:zip"
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.6.0"
  },
  "dependencies": {
    "react-color": "^2.19.3"
  }
}